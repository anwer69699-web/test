--// Ghost Toggle (Key U) - Hidden feature from original
uis.InputBegan:Connect(function(obj, gameProcessed)
	if gameProcessed then return end
	if obj.KeyCode == Enum.KeyCode.U then
		if hooked then
			if raknet then pcall(function() raknet.remove_send_hook(rakhook) end) end
			removeGhost()
			hooked = false
		else
			local char = lp.Character
			if not char then return end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			createGhost(hrp.Position)
			if raknet then pcall(function() raknet.add_send_hook(rakhook) end) end
			hooked = true
		end
	end
end)

